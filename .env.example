PORT=3080
MOCK_OPENCLAW=0
OPENCLAW_BIN=openclaw
# Project context exports (Markdown) for sync to Mac via Drive/rsync
# OPENCLAW_EXPORT_DIR=~/clawd/exports
OPENCLAW_GATEWAY_PORT=18789
# Gateway probe tuning (Pi kiosk — reduces status flapping)
# OPENCLAW_PROBE_TIMEOUT_MS=5000
# OPENCLAW_PROBE_RETRIES=2
# PROBE_FAILURE_THRESHOLD=3
# PROBE_RECOVERY_GRACE_MS=30000
# Optional: dedicated agent for kiosk voice (must have concierge-display skill)
# OPENCLAW_VOICE_AGENT=concierge-voice
# Optional: separate agent for desk text chat (defaults to OPENCLAW_VOICE_AGENT)
# OPENCLAW_CHAT_AGENT=concierge-voice
NODE_ENV=development
WEATHER_CACHE_MINUTES=15
